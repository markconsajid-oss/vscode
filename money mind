import 'dart:io';
import 'package:flutter/material.dart';
import 'package:image_picker/image_picker.dart';
import 'package:google_ml_kit/google_ml_kit.dart';
import '../../services/expense_service.dart';

class ReceiptScannerScreen extends StatefulWidget {
  final String userId;
  ReceiptScannerScreen({required this.userId});

  @override
  State<ReceiptScannerScreen> createState() => _ReceiptScannerScreenState();
}

class _ReceiptScannerScreenState extends State<ReceiptScannerScreen> {
  File? _image;
  String _scannedText = '';
  final ImagePicker _picker = ImagePicker();
  final ExpenseService _expenseService = ExpenseService();

  _pickImage() async {
    final XFile? pickedFile = await _picker.pickImage(source: ImageSource.camera);
    if (pickedFile != null) {
      setState(() => _image = File(pickedFile.path));
      _scanText();
    }
  }

  _scanText() async {
    if (_image == null) return;
    final inputImage = InputImage.fromFile(_image!);
    final textDetector = GoogleMlKit.vision.textRecognizer();
    final RecognizedText recognizedText = await textDetector.processImage(inputImage);

    String text = recognizedText.text;
    setState(() => _scannedText = text);

    textDetector.close();
  }

  _saveExpenseFromText() async {
    // Simple parsing example: extract first number as amount
    RegExp exp = RegExp(r'\d+');
    String? amountStr = exp.firstMatch(_scannedText)?.group(0);
    if (amountStr != null) {
      await _expenseService.addExpense(
        widget.userId,
        double.parse(amountStr),
        'Unknown',
        _scannedText,
        DateTime.now(),
      );
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('Expense added!')));
      Navigator.pop(context);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('Scan Receipt')),
      body: Padding(
        padding: EdgeInsets.all(16),
        child: Column(
          children: [
            _image == null
                ? Text('No image selected')
                : Image.file(_image!, height: 250),
            SizedBox(height: 16),
            ElevatedButton(onPressed: _pickImage, child: Text('Capture Receipt')),
            SizedBox(height: 16),
            Text('Detected Text:'),
            Expanded(child: SingleChildScrollView(child: Text(_scannedText))),
            ElevatedButton(onPressed: _saveExpenseFromText, child: Text('Save as Expense')),
          ],
        ),
      ),
    );
  }
}
dependencies:
  openai: ^1.0.0
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:openai/openai.dart';

class AIService {
  final CollectionReference _aiCollection = FirebaseFirestore.instance.collection('ai_insights');
  final OpenAI openAI = OpenAI(apiKey: 'YOUR_OPENAI_API_KEY');

  Future<void> generateAIInsights(String userId, String month, List<Map<String, dynamic>> expenses) async {
    String expenseData = expenses.map((e) => '${e['category']}: ${e['amount']} PKR').join('\n');

    final completion = await openAI.chat.completions.create(
      model: 'gpt-4o-mini',
      messages: [
        {'role': 'system', 'content': 'You are a financial assistant AI.'},
        {'role': 'user', 'content': 'Analyze this spending data:\n$expenseData\nGive 3 insights and 3 saving tips.'},
      ],
    );

    String aiText = completion.choices.first.message.content;

    Map<String, dynamic> insightsJson = {
      'summary': aiText.split('\n').first,
      'insights': aiText.split('\n').where((line) => line.contains('Insight')).toList(),
      'savingTips': aiText.split('\n').where((line) => line.contains('Tip')).toList(),
    };

    await _aiCollection.doc('${userId}_$month').set({
      'userId': userId,
      'month': month,
      'insightsJson': insightsJson,
    });
  }

  Stream<DocumentSnapshot> getAIInsights(String userId, String month) {
    return _aiCollection.doc('${userId}_$month').snapshots();
  }
}
